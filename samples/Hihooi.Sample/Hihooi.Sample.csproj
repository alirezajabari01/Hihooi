<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- ProjectReference + PrivateAssets on Hihooi does not flow Core/SqlServer compile assets; reference them explicitly in-repo. -->
    <ProjectReference Include="..\..\src\Hihooi\Hihooi.csproj" />
    <ProjectReference Include="..\..\src\Hihooi.Core\Hihooi.Core.csproj" />
    <ProjectReference Include="..\..\src\Hihooi.SqlServer\Hihooi.SqlServer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>

</Project>
